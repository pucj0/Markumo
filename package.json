{
  "name": "lightedit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "tauri": "node scripts/tauri.mjs",
    "tauri:watch": "node scripts/tauri.mjs dev --watch",
    "test:native:save": "node tests/native-save-stability.mjs",
    "test:native:workspace": "node tests/phase4-native.mjs",
    "test:ui": "node tests/phase2-ui.mjs",
    "test:ui:files": "node tests/phase3-ui.mjs",
    "test:ui:editor": "node tests/editor-browser.mjs",
    "test:ui:phase6": "node tests/editor-phase6.mjs",
    "test:ui:theme": "node tests/theme-ui.mjs",
    "test:ui:selection": "node tests/selection-ui.mjs",
    "test:ui:menu": "node tests/menu-ui.mjs",
    "test:ui:clipboard": "node tests/clipboard-ui.mjs",
    "test:ui:workspace-tools": "node tests/workspace-tools-ui.mjs",
    "test:native:editor": "node tests/editor-native.mjs",
    "test": "vitest run --pool=forks --maxWorkers=1 --minWorkers=1",
    "test:ui:markdown-clicks": "node tests/markdown-click-ui.mjs",
    "test:ui:settings": "node tests/settings-ui.mjs",
    "test:ux:model": "node tests/ux-model-check.mjs",
    "test:ux:ui": "node tests/ux-special-ui.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.0",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.4.2",
    "markdown-it": "^15.0.2",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^20.11.30",
    "@vitejs/plugin-vue": "^5.0.4",
    "typescript": "^5.4.3",
    "vite": "^5.2.0",
    "vitest": "2.1.9",
    "vue-tsc": "^2.0.7"
  }
}
